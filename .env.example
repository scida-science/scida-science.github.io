# Public Supabase connection settings. Copy to .env.local for local development.
# These values are embedded in the public JavaScript bundle by Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put a Supabase secret/service_role key, database password, access token,
# or GitHub token here or in any VITE_ variable.
