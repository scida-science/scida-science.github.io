{
  "name": "scida-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:backend": "vitest run backend",
    "check:backend": "tsc --noEmit -p backend/tsconfig.json",
    "build:backend": "node scripts/build-backend.mjs",
    "test:worker": "node scripts/check-worker-runtime.mjs",
    "dev:backend": "wrangler dev --config backend/wrangler.jsonc",
    "deploy:backend": "wrangler deploy --config backend/wrangler.jsonc"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.2",
    "miniflare": "5.20261012.0-beta",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
