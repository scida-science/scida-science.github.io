{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SciDA discovery repository document",
  "description": "Store as discovery.json at the root of an approved private discovery-* repository. This describes research metadata and owner-managed material access. Use explicit visibility: signed-in is the conservative choice; public deliberately exposes the brief and its discussion through SciDA. This file contains no accounts or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "visibility",
    "discovery",
    "materials"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "signed-in"
      ],
      "default": "signed-in"
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "materials": {
      "$ref": "#/$defs/materialMap"
    }
  },
  "$defs": {
    "stage": {
      "enum": ["Awaiting Validation", "Validated", "Published", "Not supported", "Refuted", "Withdrawn"]
    },
    "statusDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason", "decidedAt", "decidedBy", "decidedByName", "version"],
      "properties": {
        "from": { "$ref": "#/$defs/stage" },
        "to": { "$ref": "#/$defs/stage" },
        "reason": { "type": "string", "minLength": 10, "maxLength": 2000, "pattern": "\\S[\\s\\S]{8,}\\S" },
        "decidedAt": { "type": "string", "format": "date-time", "maxLength": 60 },
        "decidedBy": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "decidedByName": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
        "version": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" }
      },
      "description": "Server-authored immutable decision. The Worker also checks that from and to differ, the chain begins in an active stage and is continuous, timestamps are chronological, and the final decision matches the current status."
    },
    "material": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "access"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\%?#:\\x00-\\x1F\\x7F])[^/]+(?:/[^/]+)*$",
              "description": "Repository-relative file path. No traversal, encoded segments, backslashes, controls, or URL query/fragment syntax."
            },
            "access": {
              "$ref": "#/$defs/materialAccess"
            },
            "format": {
              "const": "multipart-zip",
              "description": "Optional reviewer package manifest transport. The path names reviewer/package.json; declared files are downloaded through the same material authorization, then verified and assembled locally. Omit for a single file."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "access"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2000,
              "pattern": "^https://[^/?#@]+(?:[/?#].*)?$",
              "description": "An external HTTPS location. The Worker returns this URL only after authorization; it never fetches external URLs."
            },
            "access": {
              "$ref": "#/$defs/materialAccess"
            }
          }
        }
      ]
    },
    "materialAccess": {
      "type": "string",
      "enum": [
        "public",
        "reader",
        "reviewer",
        "admin"
      ],
      "description": "Public still requires visibility to the discovery. Reader requires sign-in. Reviewer requires approval for this discovery topic (also applies to the owner). Admin requires the configured owner GitHub ID."
    },
    "materialMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "appendix",
        "figures",
        "data",
        "repository"
      ],
      "properties": {
        "paper": {
          "$ref": "#/$defs/material",
          "default": null
        },
        "appendix": {
          "$ref": "#/$defs/material",
          "default": null
        },
        "figures": {
          "$ref": "#/$defs/material",
          "default": null
        },
        "data": {
          "$ref": "#/$defs/material",
          "default": null
        },
        "repository": {
          "$ref": "#/$defs/material",
          "default": null
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "equation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        }
      }
    },
    "legacyMaterials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "appendix",
        "figures",
        "data",
        "repository"
      ],
      "description": "Compatibility slots for the shared frontend Discovery type. Keep all null in repository documents; returned URLs are generated from the authoritative top-level materials map.",
      "properties": {
        "paper": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2000,
              "pattern": "^https?://[^/?#@]+(?:[/?#].*)?$"
            }
          ],
          "default": null
        },
        "appendix": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2000,
              "pattern": "^https?://[^/?#@]+(?:[/?#].*)?$"
            }
          ],
          "default": null
        },
        "figures": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2000,
              "pattern": "^https?://[^/?#@]+(?:[/?#].*)?$"
            }
          ],
          "default": null
        },
        "data": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2000,
              "pattern": "^https?://[^/?#@]+(?:[/?#].*)?$"
            }
          ],
          "default": null
        },
        "repository": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2000,
              "pattern": "^https?://[^/?#@]+(?:[/?#].*)?$"
            }
          ],
          "default": null
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "field",
        "topic",
        "status",
        "summary",
        "updatedAt",
        "version",
        "reviewNote",
        "sections",
        "materials"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[A-Z0-9][A-Za-z0-9_-]{1,79}$",
          "description": "Stable unique ID across all discovery repositories."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "pattern": "\\S"
        },
        "field": {
          "enum": [
            "Astronomy",
            "Artificial Intelligence"
          ]
        },
        "topic": {
          "enum": [
            "bandit-theory",
            "machine-learning",
            "scientific-ai",
            "time-domain-astronomy",
            "exoplanets",
            "galaxy-evolution"
          ]
        },
        "status": {
          "$ref": "#/$defs/stage"
        },
        "statusHistory": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/statusDecision" },
          "description": "Append-only decisions recorded by the Worker. Required and nonempty for archived discoveries. Existing active discoveries may omit this field. Never truncate or rewrite existing decisions."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "pattern": "\\S"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 60,
          "description": "Server-updated timestamp; manually editing GitHub content must advance this value so open website forms detect stale edits."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "reviewNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "pattern": "\\S"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/section"
          },
          "description": "Every section ID must be unique within the discovery; the Worker validates this semantic rule."
        },
        "materials": {
          "$ref": "#/$defs/legacyMaterials"
        },
        "illustrative": {
          "type": "boolean",
          "description": "Keep true for placeholder research. Workflow labels do not establish actual validation or publication."
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S",
          "description": "Short scientific question shown on the scrolling and detail pages."
        },
        "headlineFigureId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
          "description": "Must identify one member of figures; shown on the scrolling page."
        },
        "figures": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/evidenceFigure"
          },
          "description": "Selected PNG evidence assets, visible to everyone who can see the brief. IDs must be unique and sectionId must identify an existing section."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["Not supported", "Refuted", "Withdrawn"] } } },
          "then": { "required": ["statusHistory"], "properties": { "statusHistory": { "minItems": 1 } } }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "Artificial Intelligence"
              }
            }
          },
          "then": {
            "properties": {
              "topic": {
                "enum": [
                  "bandit-theory",
                  "machine-learning",
                  "scientific-ai"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "Astronomy"
              }
            }
          },
          "then": {
            "properties": {
              "topic": {
                "enum": [
                  "time-domain-astronomy",
                  "exoplanets",
                  "galaxy-evolution"
                ]
              }
            }
          }
        }
      ]
    },
    "evidenceFigure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "caption",
        "alt",
        "sectionId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "path": {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\%?#:\\x00-\\x1F\\x7F])[^/]+(?:/[^/]+)*$",
              "description": "Repository-relative file path. No traversal, encoded segments, backslashes, controls, or URL query/fragment syntax."
            },
            {
              "pattern": "\\.png$"
            }
          ]
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "pattern": "\\S"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "pattern": "\\S"
        },
        "sectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    }
  }
}
